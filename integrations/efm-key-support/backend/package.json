{
  "name": "efm-api",
  "version": "1.0.0",
  "description": "Backend API for Stable Management System - Next.js with TypeScript",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 8500",
    "db:tunnel": "ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -L 15433:127.0.0.1:5433 root@187.77.185.220",
    "prebuild": "node scripts/prisma-generate-safe.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "test:prisma-generate-safe": "node scripts/prisma-generate-safe.test.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed-safe.js",
    "seed:medicine": "node prisma/seed-medicine-safe.js",
    "seed:medicine-logs": "node prisma/seed-medicine-logs-safe.js",
    "seed:admin": "node prisma/seed-admin.js",
    "seed:eirs-mapping": "node prisma/seed-instructor-horses.js",
    "seed:lookups": "node prisma/seed-lookups.js",
    "seed:permissions": "node scripts/seed-permissions-v2.js && node scripts/seed-permissions-nav.js",
    "register:features": "node scripts/auto-register-features.js",
    "postbuild": "node scripts/auto-register-features.js || true",
    "cache:flush": "node scripts/flush-cache.js",
    "integration:key": "node scripts/integration-key.mjs",
    "test:integration-keys": "node scripts/test-integration-keys.cjs"
  },
  "prisma": {
    "seed": "node prisma/seed-safe.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.998.0",
    "@prisma/client": "^5.18.0",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.6.22",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-validator": "^7.1.0",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.3.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^5.11.0",
    "resend": "^6.9.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/busboy": "^1.5.3",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^8.33.0",
    "eslint-config-next": "^15.5.18",
    "prisma": "^5.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "brace-expansion": ">=5.0.8",
    "sharp": "$sharp",
    "kysely": "0.28.17",
    "baseline-browser-mapping": ">=2.11.0",
    "js-yaml": "5.4.2",
    "qs": ">=6.16.0"
  }
}

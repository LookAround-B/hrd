generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EfmIntegrationKey {
  id         String   @id @default(cuid())
  name       String
  keyHash    String   @unique
  keyPrefix  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([employeeId])
}

model Employee {
  id                        String                      @id @default(cuid())
  fullName                  String
  email                     String                      @unique
  password                  String?
  emailVerified             Boolean                     @default(false)
  phoneNumber               String?
  designation               String
  designationId             Int?
  designationLookup         Designation?                @relation(fields: [designationId], references: [id])
  department                String
  departmentId              Int?
  departmentLookup          Department?                 @relation(fields: [departmentId], references: [id])
  colorCode                 String?
  profileImage              String?
  shiftTiming               String?
  employmentStatus          String                      @default("Active")
  employmentStatusId        Int?
  employmentStatusLookup    EmploymentStatus?           @relation(fields: [employmentStatusId], references: [id])
  isApproved                Boolean                     @default(false)
  approvalNotifiedAt        DateTime?
  supervisorId              String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  accounts                  Account[]
  sessions                  Session[]
  integrationKeys           EfmIntegrationKey[]
  accidentReports           AccidentReport[]            @relation("accidentReportInstructor")
  extraHorsesRegisterGroom  ExtraHorsesRegister[]       @relation("extraHorsesRegisterGroom")
  extraHorsesRegisterAssigned ExtraHorsesRegister[]     @relation("extraHorsesRegisterAssignedBy")
  createdApprovals          Approval[]                  @relation("approver")
  attendanceRecords         Attendance[]                @relation("attendanceRecords")
  attendanceLogs            AttendanceLog[]
  auditLogs                 AuditLog[]
  supervisor                Employee?                   @relation("supervision", fields: [supervisorId], references: [id])
  subordinates              Employee[]                  @relation("supervision")
  permissions               EmployeePermission?
  taskPermissions           EmployeeTaskPermission[]    @relation("employeeTaskPermissions")
  featurePermissions        EmployeeFeaturePermission[] @relation("employeeFeaturePermissions")
  expensesCreated           Expense[]                   @relation("expenseCreatedBy")
  aicavalliSalesCreated      AicavalliSale[]             @relation("aicavalliSaleCreatedBy")
  aicavalliExpensesCreated   AicavalliExpense[]          @relation("aicavalliExpenseCreatedBy")
  assignedExpenses          Expense[]                   @relation("employeeExpenses")
  farrierInvCreated         FarrierInventory[]          @relation("farrierInvCreatedBy")
  farrierInvFarrier         FarrierInventory[]          @relation("farrierInvFarrier")
  farrierShoeings           FarrierShoeing[]            @relation("farrierShoeings")
  feedInventoryRecords      FeedInventory[]             @relation("feedInventoryRecords")
  feedInventoryOrdered      FeedInventory[]             @relation("feedInventoryOrderedBy")
  finesIssued               Fine[]                      @relation("finesIssued")
  finesReceived             Fine[]                      @relation("finesReceived")
  finesResolved             Fine[]                      @relation("finesResolved")
  gateAttendanceLogs        GateAttendanceLog[]
  gateEntriesAsEmployee     GateEntry[]                 @relation("gateEntriesAsEmployee")
  gateEntries               GateEntry[]                 @relation("gateEntries")
  gateBreakEntries          GateBreakEntry[]            @relation("employeeBreakEntries")
  grassBeddingCollected     GrassBeddingEntry[]         @relation("grassBeddingCollectedBy")
  grassBeddingCreated       GrassBeddingEntry[]         @relation("grassBeddingCreatedBy")
  groceriesInventoryCreated GroceriesInventory[]        @relation("groceriesInventoryCreated")
  groceriesInventory        GroceriesInventory[]        @relation("groceriesInventory")
  groomWorkSheets           GroomWorkSheet[]            @relation("groomWorkSheets")
  healthRecords             HealthRecord[]
  supervisedHorses          Horse[]                     @relation("horseSupervision")
  assignedHorses            HorseCareTeam[]             @relation("assignedStaff")
  horseFeedRecords          HorseFeed[]                 @relation("horseFeedRecords")
  housekeepingStaff         HousekeepingInventory[]     @relation("housekeepingStaff")
  housekeepingCreated       HousekeepingInventory[]     @relation("housekeepingCreatedBy")
  inspectionRounds          InspectionRound[]           @relation("inspectionRounds")
  resolvedInspections       InspectionRound[]           @relation("resolvedInspections")
  instructorRecords         InstructorDailyWorkRecord[] @relation("instructorRecords")
  riderRecords              InstructorDailyWorkRecord[] @relation("riderRecords")
  horseMappings             InstructorHorseMapping[]    @relation("employeeHorseMappings")
  approvedIncentives        InstructorIncentive[]       @relation("approvedIncentives")
  createdIncentives         InstructorIncentive[]       @relation("createdIncentives")
  instructorIncentives      InstructorIncentive[]       @relation("instructorIncentives")
  roundChecks               JamedarRoundCheck[]         @relation("roundChecks")
  medicineInventoryRecords  MedicineInventory[]         @relation("medicineInventoryRecords")
  medicineLogsApproved      MedicineLog[]               @relation("medicineLogsApproved")
  jamiedarMedicineLogs      MedicineLog[]               @relation("jamiedarMedicineLogs")
  meetingsCreated           Meeting[]                   @relation("meetingsCreated")
  meetingParticipants       MeetingParticipant[]        @relation("meetingParticipants")
  notifications             Notification[]
  pushSubscriptions         PushSubscription[]
  reportedReports           Report[]                    @relation("reportedEmployee")
  createdReports            Report[]                    @relation("reporter")
  tackCreated               TackInventory[]             @relation("tackCreatedBy")
  tackRider                 TackInventory[]             @relation("tackRider")
  tackPurchased             TackInventory[]             @relation("tackPurchasedBy")
  tackIssuesAssigned        TackIssue[]                 @relation("tackIssueRider")
  assignedTasks             Task[]
  createdTasks              Task[]                      @relation("TaskCreatedBy")
  instructorTasks           Task[]                      @relation("TaskInstructor")
  workRecords               WorkRecord[]                @relation("workRecords")
  cutleriesInventoryRecords CutleriesInventory[]        @relation("cutleriesInventoryRecords")
  groceryTrackerRecords     GroceryTracker[]            @relation("groceryTrackerRecords")
  stockTrackerRecords       StockTracker[]              @relation("stockTrackerRecords")

  @@index([designation])
  @@index([department])
  @@index([supervisorId])
  @@index([email])
  @@index([employmentStatus])
  @@index([designation, employmentStatus])
  @@index([designationId])
  @@index([departmentId])
  @@index([employmentStatusId])
}

model Horse {
  id                    String                      @id @default(cuid())
  name                  String                      @unique
  gender                String?
  genderId              Int?
  genderLookup          HorseGender?                @relation(fields: [genderId], references: [id])
  dateOfBirth           DateTime?
  horseEntryType        String                      @default("Normal")
  horseEntryTypeId      Int?
  horseEntryTypeLookup  HorseEntryType?             @relation(fields: [horseEntryTypeId], references: [id])
  breed                 String?
  breedId               Int?
  breedLookup           HorseBreed?                 @relation(fields: [breedId], references: [id])
  color                 String?
  colorId               Int?
  colorLookup           HorseColor?                 @relation(fields: [colorId], references: [id])
  height                Float?
  age                   Int?
  location              String?
  stableNumber          String?                     @unique
  profileImage          String?
  status                String                      @default("Active")
  statusId              Int?
  statusLookup          HorseStatus?                @relation(fields: [statusId], references: [id])
  discipline            String?
  trainingLevel         String?
  workloadLimit         String?
  girthSize             String?
  bitSize               String?
  rugSize               String?
  bridleSize            String?
  numnahSize            String?
  ueln                  String?
  microchipNumber       String?
  feiId                 String?
  feiIdExpiry           DateTime?
  passportNumber        String?
  passportDetails       String?
  sire                  String?
  damsire               String?
  ownerName             String?
  ownerContact          String?
  privateDiagnosisNotes String?
  privateEntryAt        DateTime?
  privateExitAt         DateTime?
  leaseStatus           String?
  emergencyContact      String?
  insuranceDetails      String?
  supervisorId          String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  accidentReports       AccidentReport[]            @relation("accidentReportHorse")
  extraHorsesRegister   ExtraHorsesRegister[]       @relation("extraHorsesRegisterHorse")
  liveryBillCells       LiveryMonthlyBillCell[]     @relation("liveryBillCells")
  expenses              Expense[]                   @relation("horseExpenses")
  farrierInvItems       FarrierInventory[]          @relation("farrierInvHorse")
  farrierShoeings       FarrierShoeing[]            @relation("horseFarrierShoeings")
  grassBeddingEntries   GrassBeddingEntry[]         @relation("grassBeddingHorse")
  healthRecords         HealthRecord[]
  supervisor            Employee?                   @relation("horseSupervision", fields: [supervisorId], references: [id])
  careTeam              HorseCareTeam[]
  feedRecords           HorseFeed[]                 @relation("horseFeedRecords")
  inspectionRounds      InspectionRound[]           @relation("inspectionRounds")
  workRecords           InstructorDailyWorkRecord[] @relation("workRecords")
  instructorMappings    InstructorHorseMapping[]    @relation("horseInstructorMappings")
  medicineLogs          MedicineLog[]               @relation("medicineLogs")
  tackItems             TackInventory[]             @relation("tackHorse")
  tackIssues            TackIssue[]                 @relation("tackIssueHorse")
  tasks                 Task[]
  groomWorkEntries      WorkSheetEntry[]            @relation("groomWorkEntries")
  groomLeadEntries      LeadEntry[]                 @relation("groomLeadEntries")

  @@index([status])
  @@index([name])
  @@index([horseEntryType])
  @@index([supervisorId])
  @@index([statusId])
  @@index([genderId])
  @@index([horseEntryTypeId])
  @@index([breedId])
  @@index([colorId])
}

model Task {
  id                    String           @id @default(cuid())
  name                  String
  type                  String
  status                String           @default("Pending")
  statusId              Int?
  statusLookup          TaskStatus?      @relation("TaskStatus", fields: [statusId], references: [id])
  horseId               String?
  instructorId          String?
  assignedEmployeeId    String
  createdById           String
  scheduledTime         DateTime
  dueTime               DateTime?
  completedTime         DateTime?
  submittedAt           DateTime?
  priority              String           @default("Medium")
  requiredProof         Boolean          @default(false)
  proofImage            String?
  proofImages           String[]         @default([])
  completionNotes       String?
  customerName          String?
  customerPhone         String?
  paymentSource         String?
  leadGroomName         String?
  leadPrice             Float?
  discount              Float?
  bookingApproved       Boolean          @default(false)
  bookingApprovedAt     DateTime?
  bookingApprovedById   String?
  totalRoomPrice        Float?
  lessonPriceWithoutTax Float?
  lessonType            String?
  clientAge             Int?
  clientWeight          Float?
  jumpingRate           Int?             @default(0)
  memberSurcharge       Float?
  leadRein              Boolean          @default(false)
  isMember              Boolean          @default(true)
  isPaid                Boolean          @default(false)
  isMembershipBooking   Boolean          @default(false)
  packageName           String?
  packageRideCount      Int?
  packageMemberCount    Int?
  packagePrice          Float?
  gstAmount             Float?
  bookingCategory       String?
  bookingCategoryId     Int?
  bookingCategoryLookup BookingCategory? @relation(fields: [bookingCategoryId], references: [id])
  bookingRideType       String?
  bookingDestination    String?
  bookingSlot           String?
  accommodationCheckIn  DateTime?
  accommodationCheckOut DateTime?
  roomType              String?
  bookingMeta           Json?
  description           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  membershipId          String?
  lessonPackageId       String?
  approvals             Approval[]
  assignedEmployee      Employee         @relation(fields: [assignedEmployeeId], references: [id])
  createdBy             Employee         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  horse                 Horse?           @relation(fields: [horseId], references: [id])
  instructor            Employee?        @relation("TaskInstructor", fields: [instructorId], references: [id])
  membership            Membership?      @relation(fields: [membershipId], references: [id])
  lessonPackage         LessonPackage?   @relation(fields: [lessonPackageId], references: [id])

  @@index([horseId])
  @@index([instructorId])
  @@index([assignedEmployeeId])
  @@index([createdById])
  @@index([status])
  @@index([scheduledTime])
  @@index([dueTime])
  @@index([customerName])
  @@index([bookingCategory])
  @@index([bookingSlot])
  @@index([instructorId, scheduledTime, bookingSlot])
  @@index([membershipId])
  @@index([lessonPackageId])
  @@index([status, scheduledTime])
  @@index([assignedEmployeeId, status])
  @@index([statusId])
  @@index([bookingCategoryId])
}

model Approval {
  id            String      @id @default(cuid())
  taskId        String
  approverId    String
  approverLevel String
  status        String      @default("Pending")
  statusId      Int?
  statusLookup  TaskStatus? @relation("ApprovalStatus", fields: [statusId], references: [id])
  comments      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  approver      Employee    @relation("approver", fields: [approverId], references: [id])
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, approverId])
  @@index([taskId])
  @@index([approverId])
  @@index([statusId])
}

model Report {
  id                 String   @id @default(cuid())
  reportedEmployeeId String
  reporterEmployeeId String
  reason             String
  category           String?
  taskId             String?
  status             String   @default("Pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  reportedEmployee   Employee @relation("reportedEmployee", fields: [reportedEmployeeId], references: [id])
  reporter           Employee @relation("reporter", fields: [reporterEmployeeId], references: [id])

  @@index([reportedEmployeeId])
  @@index([reporterEmployeeId])
}

model HealthRecord {
  id               String            @id @default(cuid())
  horseId          String
  healthAdvisorId  String?
  recordType       String
  recordTypeId     Int?
  recordTypeLookup HealthRecordType? @relation(fields: [recordTypeId], references: [id])
  description      String?
  date             DateTime
  nextDueDate      DateTime?
  documents        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  healthAdvisor    Employee?         @relation(fields: [healthAdvisorId], references: [id])
  horse            Horse             @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([horseId])
  @@index([healthAdvisorId])
  @@index([date])
  @@index([recordTypeId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Notification {
  id                String            @id @default(cuid())
  employeeId        String
  type              String
  typeId            Int?
  typeLookup        NotificationType? @relation(fields: [typeId], references: [id])
  title             String
  message           String
  isRead            Boolean           @default(false)
  relatedTaskId     String?
  relatedApprovalId String?
  createdAt         DateTime          @default(now())
  readAt            DateTime?
  employee          Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([isRead])
  @@index([employeeId, isRead])
  @@index([employeeId, createdAt])
  @@index([typeId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       Employee @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AttendanceLog {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime  @default(now())
  timeIn     DateTime
  timeOut    DateTime?
  shift      String?
  notes      String?
  approvedBy String?
  isApproved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
}

model GateAttendanceLog {
  id         String    @id @default(cuid())
  guardId    String
  personName String
  personType String
  entryTime  DateTime
  exitTime   DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  guard      Employee  @relation(fields: [guardId], references: [id], onDelete: Cascade)

  @@index([guardId])
  @@index([entryTime])
}

model VisitorLog {
  id            String    @id @default(cuid())
  visitorName   String
  purpose       String
  checkInTime   DateTime
  checkOutTime  DateTime?
  contactPerson String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MedicineLog {
  id                   String                  @id @default(cuid())
  jamiedarId           String
  horseId              String
  medicineName         String
  diagnosis            String?
  quantity             Float
  unit                 String                  @default("ml")
  timeAdministered     DateTime
  legs                 String?
  sentTo               String[]                @default([])
  notes                String?
  photoUrl             String?
  photoUrls            String[]                @default([])
  tat                  String?
  stockAlert           Boolean                 @default(false)
  approvalStatus       String                  @default("pending")
  approvalStatusId     Int?
  approvalStatusLookup MedicineApprovalStatus? @relation(fields: [approvalStatusId], references: [id])
  approvedById         String?
  rejectionReason      String?
  approvalDate         DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  approvedBy           Employee?               @relation("medicineLogsApproved", fields: [approvedById], references: [id])
  horse                Horse                   @relation("medicineLogs", fields: [horseId], references: [id], onDelete: Cascade)
  jamedar              Employee                @relation("jamiedarMedicineLogs", fields: [jamiedarId], references: [id], onDelete: Cascade)

  @@index([jamiedarId])
  @@index([horseId])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([approvalStatusId])
}

model AccidentReport {
  id                  String   @id @default(cuid())
  instructorId        String
  horseId             String
  accidentDate        DateTime
  accidentTime        String
  accidentLocation    String
  personName          String
  personAge           Int?
  personAddress       String?
  horseSex            String?
  horseAge            Int?
  horseHeight         String?
  horseOwner          String?
  riddenPreviously    Boolean?
  horseState          String?
  riderGrouping       String?
  activityType        String?
  competingDiscipline String?
  hardhatCorrect      Boolean?
  fallType            String?
  riderInjured        Boolean?
  medicalAttention    String?
  noAttentionReason   String?
  riderRemounted      Boolean?
  horseInjured        Boolean?
  vetAttentionGiven   Boolean?
  accidentDetails     String
  witnessNames        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  instructor          Employee @relation("accidentReportInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  horse               Horse    @relation("accidentReportHorse", fields: [horseId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@index([horseId])
  @@index([accidentDate])
}

model ExtraHorsesRegister {
  id           String   @id @default(cuid())
  date         DateTime
  groomId      String
  horseId      String
  horseType    String
  extraTask    String
  startTime    String
  endTime      String
  completed    Boolean  @default(false)
  assignedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  groom        Employee @relation("extraHorsesRegisterGroom", fields: [groomId], references: [id], onDelete: Cascade)
  horse        Horse    @relation("extraHorsesRegisterHorse", fields: [horseId], references: [id], onDelete: Cascade)
  assignedBy   Employee @relation("extraHorsesRegisterAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([groomId])
  @@index([horseId])
  @@index([assignedById])
  @@index([date])
}

// One money cell of the Livery Monthly Feed Bill grid — a single feed/service
// amount for one horse in one month. Cells are sparse (only non-empty amounts
// are stored); the grid's rows come from a live query of Private horses and its
// columns from LIVERY_BILL_ITEMS in code, so this table just holds the values.
model LiveryMonthlyBillCell {
  id        String   @id @default(cuid())
  month     String   // "YYYY-MM"
  horseId   String
  item      String   // one of the LIVERY_BILL_ITEMS keys
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  horse     Horse    @relation("liveryBillCells", fields: [horseId], references: [id], onDelete: Cascade)

  @@unique([month, horseId, item])
  @@index([month])
  @@index([horseId])
}

model HorseCareTeam {
  id           String        @id @default(cuid())
  horseId      String
  staffId      String
  role         String
  roleId       Int?
  roleLookup   CareTeamRole? @relation(fields: [roleId], references: [id])
  isActive     Boolean       @default(true)
  assignedDate DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  horse        Horse         @relation(fields: [horseId], references: [id], onDelete: Cascade)
  staff        Employee      @relation("assignedStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([horseId, staffId, role])
  @@index([horseId])
  @@index([staffId])
  @@index([roleId])
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model GroomWorkSheet {
  id            String           @id @default(cuid())
  groomId       String?
  date          DateTime         @default(now())
  totalAM       Float            @default(0)
  totalPM       Float            @default(0)
  wholeDayHours Float            @default(0)
  woodchipsUsed Float            @default(0)
  bichaliUsed   Float            @default(0)
  booSaUsed     Int              @default(0)
  remarks       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  groom         Employee?        @relation("groomWorkSheets", fields: [groomId], references: [id], onDelete: Cascade)
  entries       WorkSheetEntry[]
  leadEntries   LeadEntry[]      @relation("worksheetLeadEntries")

  @@index([groomId])
  @@index([date])
}

model WorkSheetEntry {
  id            String         @id @default(cuid())
  worksheetId   String
  horseId       String?
  amHours       Float          @default(0)
  pmHours       Float          @default(0)
  wholeDayHours Float          @default(0)
  woodchipsUsed Float          @default(0)
  bichaliUsed   Float          @default(0)
  booSaUsed     Int            @default(0)
  remarks       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  horse         Horse?         @relation("groomWorkEntries", fields: [horseId], references: [id], onDelete: Cascade)
  worksheet     GroomWorkSheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)

  @@index([worksheetId])
  @@index([horseId])
}

model LeadEntry {
  id          String         @id @default(cuid())
  worksheetId String
  horseId     String?
  amHours     Float          @default(0)
  rideType    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  horse       Horse?         @relation("groomLeadEntries", fields: [horseId], references: [id], onDelete: Cascade)
  worksheet   GroomWorkSheet @relation("worksheetLeadEntries", fields: [worksheetId], references: [id], onDelete: Cascade)

  @@index([worksheetId])
  @@index([horseId])
}

model WorkRecord {
  id            String            @id @default(cuid())
  staffId       String
  date          DateTime          @default(now())
  category      String
  totalAM       Float             @default(0)
  totalPM       Float             @default(0)
  wholeDayHours Float             @default(0)
  remarks       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  staff         Employee          @relation("workRecords", fields: [staffId], references: [id], onDelete: Cascade)
  entries       WorkRecordEntry[]

  @@index([staffId])
  @@index([date])
}

model WorkRecordEntry {
  id              String     @id @default(cuid())
  recordId        String
  taskDescription String
  amHours         Float      @default(0)
  pmHours         Float      @default(0)
  wholeDayHours   Float      @default(0)
  remarks         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  record          WorkRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

model Attendance {
  id           String            @id @default(cuid())
  employeeId   String
  date         DateTime
  checkInTime  DateTime?
  checkOutTime DateTime?
  status       String            @default("Present")
  statusId     Int?
  statusLookup AttendanceStatus? @relation("AttendanceStatusRel", fields: [statusId], references: [id])
  remarks      String?
  markedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  employee     Employee          @relation("attendanceRecords", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([statusId])
}

model GateEntry {

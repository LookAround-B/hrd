// =============================================================================
// LOOKUP TABLES (additive — Phase 1)
//
// All lookup tables share the same shape so a single generic admin UI + API
// can manage them. No existing model is modified in this phase: FK rewires
// happen in later phases per expand→migrate→contract pattern.
//
// Conventions:
//   code      — stable machine identifier (UPPER_SNAKE), used in API code
//   label     — human-readable display value (matches existing prod strings
//               at seed time so future FK backfills are 1:1)
//   color     — optional UI hint (hex or token)
//   sortOrder — display order in dropdowns
//   isActive  — soft toggle (do not show in dropdowns when false)
//   isSystem  — protected from delete via UI (used by code paths)
//   metadata  — JSON for domain-specific extras (e.g. role level, hierarchy)
// =============================================================================

model Designation {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  label     String     @unique
  color     String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  isSystem  Boolean    @default(false)
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@index([isActive, sortOrder])
}


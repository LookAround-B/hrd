+      horse: { select: { id: true, name: true } },
+    } }),
+    prisma.horseFeed.count(),
+  ])
+  return res.status(200).json({ data, pagination: { total, skip: Number(skip), take: Number(take) } })
+}, { methods: ['GET'] })

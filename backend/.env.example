DATABASE_URL=postgresql://hrd:hrd@localhost:55439/hrd
# Local Postgres usually has no SSL. Remove this line (SSL on) for hosted databases.
DB_SSL=false
# Generate: openssl rand -base64 32. Use the SAME value for API and cron.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
APP_ORIGIN=http://localhost:8001
# Exact hostnames only. No wildcard, port, scheme, or path.
EFM_ALLOWED_HOSTS=efm.eirs.app
# For tests only; never point this at the EFM database.
HRD_TEST_DATABASE_URL=

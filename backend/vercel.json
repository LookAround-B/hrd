{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd .. && npx --yes pnpm@11.7.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.7.0 run build",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 3 * * *"
    }
  ]
}
